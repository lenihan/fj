{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },

  "configurePresets": [
    {
      "name": "_base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    },

    {
      "name": "windows-x64",
      "displayName": "Windows x64 - Native x64",
      "inherits": "_base",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "../qt_v6.8.3/install_x64"
      }
    },

    {
      "name": "windows-arm64",
      "displayName": "Windows ARM64 - Native ARM64",
      "inherits": "_base",
      "architecture": "arm64",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "../qt_v6.8.3/install_arm64"
      }
    },

    {
      "name": "linux",
      "displayName": "Linux - Native",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],

  "buildPresets": [
    { "name": "windows-x64-debug",     "configurePreset": "windows-x64",   "configuration": "Debug" },
    { "name": "windows-x64-release",   "configurePreset": "windows-x64",   "configuration": "Release" },

    { "name": "windows-arm64-debug",   "configurePreset": "windows-arm64", "configuration": "Debug" },
    { "name": "windows-arm64-release", "configurePreset": "windows-arm64", "configuration": "Release" },

    { "name": "bakeFont-windows-x64",   "configurePreset": "windows-x64",   "configuration": "Debug", "targets": ["bakeFont"] },
    { "name": "bakeFont-windows-arm64", "configurePreset": "windows-arm64", "configuration": "Debug", "targets": ["bakeFont"] },

    { "name": "linux-debug",   "configurePreset": "linux", "configuration": "Debug" },
    { "name": "linux-release", "configurePreset": "linux", "configuration": "Release" }
  ],

  "workflowPresets": [
    {
      "name": "windows-x64-debug",
      "displayName": "Configure + build fj (Windows x64, Debug)",
      "steps": [
        { "type": "configure", "name": "windows-x64" },
        { "type": "build",     "name": "windows-x64-debug" }
      ]
    },
    {
      "name": "windows-x64-release",
      "displayName": "Configure + build fj (Windows x64, Release)",
      "steps": [
        { "type": "configure", "name": "windows-x64" },
        { "type": "build",     "name": "windows-x64-release" }
      ]
    },
    {
      "name": "windows-arm64-debug",
      "displayName": "Configure + build fj (Windows ARM64, Debug)",
      "steps": [
        { "type": "configure", "name": "windows-arm64" },
        { "type": "build",     "name": "windows-arm64-debug" }
      ]
    },
    {
      "name": "windows-arm64-release",
      "displayName": "Configure + build fj (Windows ARM64, Release)",
      "steps": [
        { "type": "configure", "name": "windows-arm64" },
        { "type": "build",     "name": "windows-arm64-release" }
      ]
    },
    {
      "name": "bakeFont-windows-x64",
      "displayName": "Configure + build bakeFont (Windows x64)",
      "steps": [
        { "type": "configure", "name": "windows-x64" },
        { "type": "build",     "name": "bakeFont-windows-x64" }
      ]
    },
    {
      "name": "bakeFont-windows-arm64",
      "displayName": "Configure + build bakeFont (Windows ARM64)",
      "steps": [
        { "type": "configure", "name": "windows-arm64" },
        { "type": "build",     "name": "bakeFont-windows-arm64" }
      ]
    },
    {
      "name": "linux-debug",
      "displayName": "Configure + build fj (Linux, Debug)",
      "steps": [
        { "type": "configure", "name": "linux" },
        { "type": "build",     "name": "linux-debug" }
      ]
    },
    {
      "name": "linux-release",
      "displayName": "Configure + build fj (Linux, Release)",
      "steps": [
        { "type": "configure", "name": "linux" },
        { "type": "build",     "name": "linux-release" }
      ]
    }
  ]
}
